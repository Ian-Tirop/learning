# Copy to .env for local `vercel dev`. In production, set these in the
# Vercel project's Environment Variables settings instead — never commit a
# real value. See README's "Deploying" section for how each one is used.

# Postgres connection string — set automatically when you attach a Vercel
# Postgres (Neon) database to the project; only needed by hand locally.
DATABASE_URL=

# Your login password for /admin/login. Anyone with this can publish, edit,
# and delete posts, and approve/reject reader submissions.
ADMIN_PASSWORD=

# Any long random string (e.g. `openssl rand -hex 32`) — signs the admin
# and reader session cookies. Changing it invalidates every existing session.
ADMIN_SESSION_SECRET=

# Anthropic API key for the chat widget — console.anthropic.com
ANTHROPIC_API_KEY=

# Resend API key + verified "from" address, for the newsletter and
# transactional emails (publish notifications, submission status, 2FA
# security alerts) — resend.com. Both unset = email sends silently no-op.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Any long random string (e.g. `openssl rand -hex 32`) — checked against the
# daily scheduled-publish cron request instead of the admin session cookie,
# since no browser is involved in a cron-triggered request.
CRON_SECRET=

# Your real deployed domain, used when generating sitemap.xml/rss.xml and
# for canonical URLs. Defaults to a https://example.com placeholder if unset.
SITE_URL=
